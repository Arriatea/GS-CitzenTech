# Copie para backend/.env e preencha. O .env não vai para o git.

# Chave do Google AI Studio usada pela Gotinha (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=COLE_SUA_CHAVE_AQUI

# Endereço deste próprio backend: as ferramentas da Gotinha consultam a água, os preços etc. por ele.
# Local: http://localhost:8000. No Render: a URL pública do serviço.
GOTA_API_URL=http://localhost:8000
