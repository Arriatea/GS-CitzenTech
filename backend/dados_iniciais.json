  "cursos": [
    {
      "id": "vender-bem",
      "figura": "💰",
      "titulo": "Vender bem",
      "cor": "amarelo",
      "passos": [
        {
          "figura": "🏪",
          "texto": "Pergunte ao mercado o que ele quer comprar."
        },
        {
          "figura": "🥬",
          "texto": "Venda só as verduras bonitas e do mesmo tamanho."
        },
        {
          "figura": "🤝",
          "texto": "A horta da comunidade é para dar. A horta de venda é para vender."
        },
        {
          "figura": "🚫",
          "texto": "Não dê de graça a verdura de venda. Ela paga o sustento da casa e a bomba do poço."
        },
        {
          "figura": "🌱",
          "texto": "Guarde um pouco de cada venda para comprar sementes."
        }
      ]
    },
    {
      "id": "plantar-alface",
      "figura": "🥬",
      "titulo": "Plantar alface",
      "cor": "laranja",
      "passos": [
        {
          "figura": "⛅",
          "texto": "Faça o canteiro onde bate sol de manhã e tem sombra à tarde."
        },
        {
          "figura": "✋",
          "texto": "Plante as mudas com um palmo de distância uma da outra."
        },
        {
          "figura": "💧",
          "texto": "Molhe todo dia, bem cedinho ou no fim da tarde."
        },
        {
          "figura": "🔪",
          "texto": "Depois de um mês e meio, colha o pé inteiro, cortando rente ao chão."
        }
      ]
    },
    {
      "id": "plantar-melancia",
      "figura": "🍉",
      "titulo": "Plantar melancia",
      "cor": "verde",
      "passos": [
        {
          "figura": "☀️",
          "texto": "Plante a melancia num lugar com muito sol."
        },
        {
          "figura": "👣",
          "texto": "Deixe dois passos largos entre uma cova e outra."
        },
        {
          "figura": "🌾",
          "texto": "Ela está madura quando o cabinho perto dela fica seco."
        },
        {
          "figura": "👂",
          "texto": "Bata na melancia com a mão. Se o som for oco, pode colher."
        }
      ]
    },
    {
      "id": "pulgao",
      "figura": "🐛",
      "titulo": "Tirar bichinhos",
      "cor": "vermelho",
      "passos": [
        {
          "figura": "🧼",
          "texto": "Rale um pedaço de sabão de coco num litro de água."
        },
        {
          "figura": "💦",
          "texto": "Ponha num borrifador e molhe embaixo das folhas."
        },
        {
          "figura": "🌇",
          "texto": "Faça no fim da tarde, por três dias seguidos."
        }
      ]
    }
