# Copie este arquivo para ".env" (na mesma pasta) e preencha.

# Endereço do backend do Gota a Gota
GOTA_API_URL=http://localhost:8000

# Opção 1: chave do Google AI Studio (mais simples) — https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=COLE_SUA_CHAVE_AQUI

# Opção 2: Vertex AI no seu projeto do Google Cloud (apague a opção 1 se usar esta)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1
